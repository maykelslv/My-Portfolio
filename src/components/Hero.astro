---
import GlyphField from './GlyphField.astro';

const roles = [
  "Builds Intuitive UI/UX",
  "Develops Responsive Interfaces",
  "Creates Seamless User Experiences",
  "Solves Design Challenges",
];
---

<section id="hero" class="relative overflow-hidden px-8 md:px-24 pt-28 pb-16 md:pt-0 md:pb-0 md:min-h-screen">
  <!-- Floating ambient shapes -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="hero-shape shape-1"></div>
    <div class="hero-shape shape-2"></div>
    <div class="hero-shape shape-3"></div>
    <div class="hero-shape shape-4"></div>
    <div class="hero-shape shape-5"></div>
    <div class="hero-shape shape-6"></div>
    <div
      class="absolute inset-0 bg-[linear-gradient(rgba(139,92,246,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(139,92,246,0.03)_1px,transparent_1px)] bg-[size:60px_60px]"
    >
    </div>
  </div>

  <!-- Hero content -->
  <div
    id="hero-content"
    class="relative z-10 max-w-3xl text-left md:absolute md:top-[18%] md:left-[10%] md:right-auto"
  >
    <!-- Section marker -->
    <div class="section-marker mb-8 hero-el" style="opacity:0;">
      <span>Home</span>
    </div>

    <!-- Main headline with word-by-word reveal -->
    <h1
      id="hero-headline"
      class="font-display text-3xl md:text-5xl lg:text-[4.5rem] font-bold tracking-tight mb-6 leading-[1.05]"
    >
      <span class="split-line"
        ><span class="hero-word text-text">Designing</span></span
      >
      <span class="split-line"
        ><span class="hero-word text-text"
          ><span class="text-accent">experiences,</span></span
        ></span
      >
      <span class="split-line"
        ><span class="hero-word text-text">not just interfaces.</span></span
      >
    </h1>

    <!-- Horizontal line that draws in -->
    <div class="hero-line-draw hero-el" style="opacity:0;">
      <div class="w-24 h-px bg-gradient-to-r from-accent to-transparent"></div>
    </div>

    <!-- Subtitle -->
    <p
      class="max-w-lg text-sm md:text-base text-text-muted tracking-[0.2em] uppercase mt-6 mb-8 hero-el"
      style="opacity:0;"
    >
      UI/UX Designer & Front-End Developer, with a passion for crafting
      immersive and user-centered digital experiences.
    </p>

    <!-- Role rotator -->
    <div class="h-10 md:h-12 overflow-hidden mb-10 hero-el" style="opacity:0;">
      <div
        id="role-rotator"
        class="flex flex-col transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
      >
        {
          roles.map((role) => (
            <span class="h-10 md:h-12 flex items-center justify-start text-lg md:text-2xl font-light text-text-secondary font-display">
              {role}
            </span>
          ))
        }
      </div>
    </div>

    <div
      class="flex items-center justify-start gap-4 hero-el"
      style="opacity:0;"
    >
      <a
        href="/projects"
        class="magnetic group inline-flex items-center relative px-8 py-4 bg-accent text-white text-sm font-medium rounded-full overflow-hidden transition-all duration-300 hover:shadow-[0_0_30px_rgba(139,92,246,0.4)]"
      >
        <span class="relative z-10">View Work</span>
        <div
          class="absolute inset-0 bg-accent-light transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"
        >
        </div>
      </a>
      <a
        href="#contact"
        class="magnetic inline-flex items-center px-8 py-4 border border-border text-text text-sm font-medium rounded-full hover:border-accent hover:text-accent transition-all duration-300"
      >
        Get in Touch
      </a>
    </div>
  </div>

  <!-- Magnetic glyph field -->
  <GlyphField />

  <!-- Scroll indicator -->
  <div
    id="hero-scroll-indicator"
    class="hidden md:flex absolute bottom-10 left-1/2 -translate-x-1/2 flex-col items-center gap-2"
    style="opacity:0;"
  >
    <span class="text-[10px] tracking-[0.25em] uppercase text-text-muted"
      >Scroll</span
    >
    <div class="scroll-line-container">
      <div class="scroll-line"></div>
    </div>
  </div>
</section>

<style>
  /* Display font override */
  .font-display {
    font-family: var(--font-display);
  }

  /* Split line containers */
  .split-line {
    display: block;
    overflow: hidden;
  }

  .split-line > span {
    display: block;
    transform: translateY(110%);
    will-change: transform;
  }

  /* Floating shapes with parallax */
  .hero-shape {
    position: absolute;
    border-radius: 50%;
    opacity: 0.06;
    animation: float 20s ease-in-out infinite;
    will-change: transform;
  }

  .shape-1 {
    width: 500px;
    height: 500px;
    background: var(--color-accent);
    top: -150px;
    right: -150px;
    animation-delay: 0s;
    filter: blur(100px);
  }

  .shape-2 {
    width: 350px;
    height: 350px;
    background: var(--color-accent-light);
    bottom: -80px;
    left: -100px;
    animation-delay: -5s;
    filter: blur(70px);
  }

  .shape-3 {
    width: 180px;
    height: 180px;
    border: 1px solid var(--color-accent);
    top: 20%;
    left: 60%;
    animation-delay: -8s;
    animation-duration: 25s;
    opacity: 0.08;
    border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
  }

  .shape-4 {
    width: 100px;
    height: 100px;
    border: 1px solid var(--color-accent);
    bottom: 25%;
    right: 15%;
    animation-delay: -12s;
    animation-duration: 18s;
    opacity: 0.08;
    border-radius: 0;
    transform: rotate(45deg);
  }

  .shape-5 {
    width: 8px;
    height: 8px;
    background: var(--color-accent);
    top: 35%;
    right: 25%;
    animation-delay: -3s;
    animation-duration: 15s;
    opacity: 0.3;
  }

  .shape-6 {
    width: 250px;
    height: 250px;
    background: radial-gradient(
      circle,
      var(--color-accent-glow) 0%,
      transparent 70%
    );
    top: 50%;
    right: 5%;
    animation-delay: -7s;
    animation-duration: 22s;
    opacity: 0.15;
    filter: blur(40px);
  }

  @keyframes float {
    0%,
    100% {
      transform: translate(0, 0) rotate(0deg);
    }
    25% {
      transform: translate(25px, -35px) rotate(5deg);
    }
    50% {
      transform: translate(-20px, 20px) rotate(-3deg);
    }
    75% {
      transform: translate(15px, 25px) rotate(2deg);
    }
  }

  /* Scroll indicator */
  .scroll-line-container {
    width: 1px;
    height: 40px;
    background: rgba(139, 92, 246, 0.15);
    position: relative;
    overflow: hidden;
    border-radius: 1px;
  }

  .scroll-line {
    width: 100%;
    height: 50%;
    background: var(--color-accent);
    border-radius: 1px;
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0% {
      transform: translateY(-100%);
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
    100% {
      transform: translateY(200%);
      opacity: 0;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initHero() {
    const heroWords = document.querySelectorAll(".hero-word");
    const heroEls = document.querySelectorAll(".hero-el");
    const scrollIndicator = document.getElementById("hero-scroll-indicator");
    const heroContent = document.getElementById("hero-content");

    gsap.to(heroWords, {
      y: 0,
      duration: 1.2,
      ease: "power3.out",
      stagger: 0.12,
      delay: 0.2,
    });

    // 2. Fade in other hero elements with stagger
    gsap.to(heroEls, {
      opacity: 1,
      y: 0,
      duration: 0.9,
      ease: "power2.out",
      stagger: 0.12,
      delay: 0.8,
    });

    // 3. Scroll indicator
    if (scrollIndicator) {
      gsap.to(scrollIndicator, {
        opacity: 1,
        duration: 0.8,
        delay: 1.6,
        ease: "power2.out",
      });
    }

    // 3b. Glyph field entrance
    const glyphField = document.getElementById("glyph-field");
    if (glyphField) {
      gsap.to(glyphField, {
        opacity: 1,
        duration: 1.8,
        delay: 1.2,
        ease: "power2.out",
      });
    }

    // 4. Parallax shapes on scroll
    gsap.utils.toArray<HTMLElement>(".hero-shape").forEach((shape, i) => {
      const speed = (i + 1) * 0.15;
      gsap.to(shape, {
        y: () => -window.innerHeight * speed,
        ease: "none",
        scrollTrigger: {
          trigger: "#hero",
          start: "top top",
          end: "bottom top",
          scrub: 0.5,
        },
      });
    });

    // 5. Hero content fade out on scroll
    if (heroContent) {
      gsap.to(heroContent, {
        opacity: 0,
        y: -80,
        ease: "none",
        scrollTrigger: {
          trigger: "#hero",
          start: "30% top",
          end: "90% top",
          scrub: 0.3,
        },
      });
    }

    // 6. Scroll indicator fade out
    if (scrollIndicator) {
      gsap.to(scrollIndicator, {
        opacity: 0,
        ease: "none",
        scrollTrigger: {
          trigger: "#hero",
          start: "10% top",
          end: "30% top",
          scrub: true,
        },
      });
    }
  }

  window.addEventListener("preloaderComplete", () => {
    setTimeout(initHero, 100);
  });

  // Fallback
  if (!document.getElementById("preloader")) {
    initHero();
  }

  // Role rotator
  const rotator = document.getElementById("role-rotator");
  if (rotator) {
    const children = rotator.children;
    const count = children.length;
    let current = 0;

    setInterval(() => {
      current = (current + 1) % count;
      const itemHeight = (children[0] as HTMLElement).offsetHeight;
      rotator.style.transform = `translateY(-${current * itemHeight}px)`;
    }, 2500);
  }

  // Magnetic hover effect for buttons
  document.querySelectorAll(".magnetic").forEach((el) => {
    const element = el as HTMLElement;
    element.addEventListener("mousemove", (e) => {
      const rect = element.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;
      element.style.transform = `translate(${x * 0.15}px, ${y * 0.15}px)`;
    });

    element.addEventListener("mouseleave", () => {
      element.style.transform = "translate(0, 0)";
    });
  });
</script>
