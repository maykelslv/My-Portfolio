---
// Preloader.astro — Cinematic name reveal intro
---

<div class="preloader" id="preloader" aria-hidden="true">
  <div class="preloader-content">
    <div class="preloader-text" id="preloader-text">
      <span class="preloader-firstname">Michael</span>
      <span class="preloader-dot"></span>
      <span class="preloader-lastname">Silva</span>
    </div>
    <div class="preloader-line" id="preloader-line"></div>
    <p class="preloader-sub" id="preloader-sub">Portfolio</p>
  </div>
</div>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 10000;
    background: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    will-change: transform;
    overflow: hidden;
  }

  .preloader-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .preloader-text {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    font-weight: 700;
    color: var(--color-text);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    overflow: hidden;
  }

  .preloader-firstname,
  .preloader-lastname {
    display: inline-block;
    transform: translateY(110%);
    opacity: 0;
    will-change: transform, opacity;
  }

  .preloader-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-accent);
    transform: scale(0);
    opacity: 0;
    will-change: transform, opacity;
  }

  .preloader-line {
    width: 0;
    height: 1px;
    background: var(--color-accent);
    opacity: 0.6;
    will-change: width;
  }

  .preloader-sub {
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    opacity: 0;
    transform: translateY(10px);
    will-change: transform, opacity;
  }
</style>

<script>
  import { gsap } from "gsap";

  const preloader = document.getElementById("preloader");
  const firstname = document.querySelector(".preloader-firstname");
  const lastname = document.querySelector(".preloader-lastname");
  const dot = document.querySelector(".preloader-dot");
  const line = document.getElementById("preloader-line");
  const sub = document.getElementById("preloader-sub");

  if (preloader && firstname && lastname && dot && line && sub) {
    // Lock scroll during preloader
    document.body.style.overflow = "hidden";

    const tl = gsap.timeline({
      onComplete: () => {
        // Dispatch custom event when preloader is done
        window.dispatchEvent(new CustomEvent("preloaderComplete"));
        // Remove preloader from DOM
        preloader.remove();
        document.body.style.overflow = "";
      },
    });

    tl.to([firstname, lastname], {
      y: 0,
      opacity: 1,
      duration: 1,
      ease: "power3.out",
      stagger: 0.15,
    })
      .to(
        dot,
        {
          scale: 1,
          opacity: 1,
          duration: 0.5,
          ease: "back.out(2)",
        },
        "-=0.5"
      )
      .to(
        line,
        {
          width: "120px",
          duration: 0.8,
          ease: "power2.inOut",
        },
        "-=0.3"
      )
      .to(
        sub,
        {
          opacity: 1,
          y: 0,
          duration: 0.6,
          ease: "power2.out",
        },
        "-=0.4"
      )
      .to(
        {},
        {
          duration: 0.6,
        }
      )
      // Exit: slide everything up and scale
      .to(preloader, {
        yPercent: -100,
        duration: 1,
        ease: "power3.inOut",
      });
  }
</script>
