---
// src/components/Contact.astro — Enhanced with dramatic reveals

// Change this to your actual email!
const email = "silva.michael.pupa@gmail.com";

const socials = [
  {
    name: "LinkedIn",
    url: "https://www.linkedin.com/in/michael-silva-476028412",
  },
  { name: "GitHub", url: "https://github.com/maykelslv" },
  { name: "Facebook", url: "https://www.facebook.com/share/1crbaVhprb/" },
];
---

<section
  id="contact"
  class="relative py-32 px-8 md:px-24 bg-bg overflow-hidden flex flex-col justify-center min-h-[80vh]"
>
  <!-- Background ambient -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div
      class="absolute w-[500px] h-[500px] bg-accent rounded-full filter blur-[150px] opacity-[0.04] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"
    >
    </div>
    <div
      class="absolute w-[300px] h-[300px] bg-accent-light rounded-full filter blur-[100px] opacity-[0.03] bottom-0 right-0"
    >
    </div>
  </div>

  <div class="max-w-5xl mx-auto w-full relative z-10">
    <!-- Section marker -->
    <div class="section-marker mb-8 fade-up contact-animate">
      <span>03 / Contact</span>
    </div>

    <!-- Giant heading with clip-path reveal -->
    <div class="overflow-hidden mb-6">
      <h2
        id="contact-heading"
        class="text-4xl md:text-6xl lg:text-[5rem] font-bold tracking-tight font-display leading-[1.1]"
        style="transform: translateY(110%);"
      >
        Let's create something
        <br />
        <span class="text-accent">together.</span>
      </h2>
    </div>

    <!-- Divider line -->
    <div class="contact-line w-full h-px bg-border/30 my-8"></div>

    <p
      class="text-text-secondary text-lg md:text-xl mb-16 max-w-2xl leading-relaxed fade-up contact-animate"
    >
      Open to internship opportunities, freelance projects, and meaningful
      collaborations. Let's build something great together.
    </p>

    <!-- Email CTA -->
    <div class="mb-20 fade-up contact-animate">
      <span
        class="text-xs text-text-muted tracking-[0.3em] uppercase mb-4 block"
        >Say hello</span
      >
      <a href={`mailto:${email}`} class="inline-block relative group pb-2">
        <span
          class="text-2xl md:text-4xl lg:text-5xl font-bold text-text group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-gradient-to-r group-hover:from-accent group-hover:to-accent-light transition-all duration-500 relative z-10 font-display"
        >
          {email}
        </span>
        <span
          class="absolute bottom-0 left-0 w-0 h-[2px] bg-gradient-to-r from-accent to-accent-light transition-all duration-600 ease-out group-hover:w-full"
        ></span>
      </a>
    </div>

    <!-- Socials -->
    <div class="flex gap-8 flex-wrap">
      {
        socials.map((social, i) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link text-text-muted hover:text-accent text-sm tracking-[0.2em] uppercase transition-all duration-300 relative group"
            style={`--delay: ${i * 0.1}s`}
          >
            {social.name}
            <span class="absolute -bottom-1 left-0 w-0 h-px bg-accent group-hover:w-full transition-all duration-300" />
          </a>
        ))
      }
    </div>
  </div>

  <!-- Footer -->
  <div
    class="absolute bottom-6 left-0 w-full text-center fade-up contact-animate"
  >
    <p class="text-text-muted text-xs tracking-wider">
      © {new Date().getFullYear()} Developed with Astro & Tailwind.
    </p>
  </div>
</section>

<style>
  .font-display {
    font-family: var(--font-display);
  }

  .contact-line {
    transform-origin: left;
    transform: scaleX(0);
  }

  .social-link {
    opacity: 0;
    transform: translateY(15px);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Giant heading reveal
  const contactHeading = document.getElementById("contact-heading");
  if (contactHeading) {
    gsap.to(contactHeading, {
      y: 0,
      duration: 1.2,
      ease: "power3.out",
      scrollTrigger: {
        trigger: contactHeading,
        start: "top 85%",
        toggleActions: "play none none none",
      },
    });
  }

  // Fade up elements
  gsap.utils.toArray<HTMLElement>(".contact-animate").forEach((el, i) => {
    gsap.fromTo(
      el,
      { opacity: 0, y: 40 },
      {
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: "power3.out",
        delay: i * 0.05,
        scrollTrigger: {
          trigger: el,
          start: "top 88%",
          toggleActions: "play none none none",
        },
      },
    );
  });

  // Contact line draw
  gsap.to(".contact-line", {
    scaleX: 1,
    duration: 1.5,
    ease: "power2.inOut",
    scrollTrigger: {
      trigger: ".contact-line",
      start: "top 85%",
      toggleActions: "play none none none",
    },
  });

  // Social links stagger
  gsap.to(".social-link", {
    opacity: 1,
    y: 0,
    duration: 0.7,
    ease: "power2.out",
    stagger: 0.1,
    scrollTrigger: {
      trigger: ".social-link",
      start: "top 90%",
      toggleActions: "play none none none",
    },
  });
</script>
